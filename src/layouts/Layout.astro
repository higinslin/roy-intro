---
import '../styles/global.css';
const { title = 'Roy Li | Public Profile', description = 'Roy Li — entrepreneur, public voice, and community advocate in Vancouver-Langara.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a class="brand" href="/">Roy <span>Li</span></a>
        <div class="nav-links">
          <a href="/about/">About</a>
          <a href="/ideas/">Ideas</a>
          <a href="/langara/">Vancouver-Langara</a>
          <a href="/notes/">Notes</a>
          <a href="/zh/">中文</a>
          <a class="button primary" href="/contact/">Contact</a>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>Roy Li</strong>
          <p>Personal website. This is not an official campaign website and does not represent a nomination or candidacy announcement.</p>
        </div>
        <p><a href="https://www.linkedin.com/in/roy-li-2a4248217/">LinkedIn</a></p>
      </div>
    </footer>
  </body>
</html>
