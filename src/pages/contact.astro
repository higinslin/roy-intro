---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact | Roy Li">
  <main>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow light">Contact</div>
        <h1>Connect with Roy.</h1>
        <p class="lead">For community conversations, media inquiries, or to share the issues facing Vancouver-Langara and British Columbia.</p>
      </div>
    </section>
    <section class="content">
      <div class="contact-grid">
        <div class="contact-card">
          <h3>Email</h3>
          <p>The fastest way to reach Roy directly.</p>
          <a class="big" href="mailto:roy@xdt.com">roy@xdt.com</a>
        </div>
        <div class="contact-card">
          <h3>LinkedIn</h3>
          <p>Professional background and updates.</p>
          <a class="big" href="https://www.linkedin.com/in/roy-li-2a4248217/" rel="noopener">linkedin.com/in/roy-li-2a4248217</a>
        </div>
      </div>
      <div class="notice">This is Roy Li’s personal website for public-profile and policy discussion. It is not accepting political contributions at this time.</div>
    </section>
  </main>
</Layout>
